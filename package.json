{
  "name": "mcd-meal-recommender",
  "version": "1.3.0",
  "description": "基于麦当劳 mcd-mcp 的套餐推荐助手 Skill：冷启动引导 + 就餐提醒 + 套餐推荐 + 偏好画像 + 饮食禁忌过滤 + 凑单建议",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcd-meal": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && node scripts/build-skill.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "format": "prettier --write .",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:pack": "node scripts/install-skill.mjs --agent workbuddy --scope user --pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
