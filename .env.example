# 套餐推荐助手 环境变量占位示例（禁止填写真实值并提交）
#
# 说明：所有变量均留空，留空即采用代码内置默认行为（默认值 / 默认开关见下方注释）。
# 需要覆盖默认行为时填写等号右侧即可；切勿提交真实 Token 或个人信息。

# ── 麦当劳 MCP 接入 ─────────────────────────────────────────────

# 麦当劳 MCP 鉴权 Token（必填；不填则走离线降级）
# 用途：mcp-client 以 `Authorization: Bearer <token>` 访问 mcd-mcp（https://mcp.mcd.cn）
# 约束：仅通过环境变量注入，禁止硬编码或提交到仓库（见 CONTEST_DECLARATION.md 信息安全声明）
MCD_MCP_TOKEN=

# 离线模式开关（可选；留空不生效）
# 用途：值为 1 时强制使用内置离线演示数据，不发起任何 MCP 调用（用于离线可复现演示）
MCD_OFFLINE=

# ── 日志 ───────────────────────────────────────────────────────

# 日志级别（可选；默认 info）
# 取值：debug | info | warn | error
# 说明：日志对 Token / 手机号 / 地址等敏感字段自动脱敏
LOG_LEVEL=

# ── 本地数据目录（v1.3.0） ──────────────────────────────────────

# 数据目录（可选；默认 = 本技能 CLI 所在技能/仓库根目录下的 data/，即 <skillDir>/data）
# 说明：画像 / 提醒配置 / 提醒状态均存于此目录；data/ 已被 .gitignore 忽略，不入库
# 相对值会被归一化为绝对路径；例 MCD_DATA_DIR=/home/me/.mcd-meal/data
MCD_DATA_DIR=

# ── 偏好画像（profile） ────────────────────────────────────────

# 画像持久化文件路径（可选；默认 <数据目录>/profile.json）
MCD_PROFILE_PATH=

# 明确选择的 EMA 系数（可选；默认 0.4；取值 (0,1]，非法值回退默认）
MCD_PROFILE_ALPHA_STRONG=

# 未明确选择 / 采纳推荐的 EMA 系数（可选；默认 0.15；取值 (0,1]）
MCD_PROFILE_ALPHA_WEAK=

# 画像保留的最近选择条数上限（可选；默认 50；正整数）
MCD_PROFILE_HISTORY_LIMIT=

# ── 就餐提醒（reminder） ───────────────────────────────────────

# 提醒配置持久化路径（可选；默认 <数据目录>/reminder-config.json）
MCD_REMINDER_CONFIG_PATH=

# 提醒去重状态持久化路径（可选；默认 <数据目录>/reminder-state.json）
MCD_REMINDER_STATE_PATH=
